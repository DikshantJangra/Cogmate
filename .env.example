# =============================================================================
# Cogmate — Unified Environment Variables
# =============================================================================
# Copy this file to .env.local (in apps/classroom/) or .env (in apps/backend/)
# and fill in at least ONE LLM provider API key.
# =============================================================================

# ═══ LLM Providers (Required for classroom generation) ═══
# Get a free key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIzaSy...

# OpenAI: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# Anthropic: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...

# ═══ Image/Video Generation (Optional, for rich classrooms) ═══
# For Gemini-based image generation (Nano Banana)
IMAGE_NANO_BANANA_API_KEY=AIzaSy...

# For Seedream/Seedance (ByteDance/Volcengine)
# IMAGE_SEEDREAM_API_KEY=...
# VIDEO_SEEDANCE_API_KEY=...

# ═══ TTS & Transcription (Optional, for audio support) ═══
# TTS_OPENAI_API_KEY=sk-...
# ASR_OPENAI_API_KEY=sk-...

# ═══ Backend Configuration ═══
BACKEND_URL=http://localhost:8000
WS_BACKEND_URL=ws://localhost:8000

# ═══ Access Code (Optional) ═══
# ACCESS_CODE=your-secret-code
